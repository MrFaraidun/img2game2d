{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://img2game2d/schemas/rig.schema.json",
  "title": "Rig",
  "description": "2D skeletal rig definition for a game asset",
  "type": "object",
  "required": ["asset_id", "bones", "root"],
  "properties": {
    "asset_id": { "type": "string" },
    "root": { "type": "string", "description": "ID of the root bone" },
    "bones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "parent", "pivot"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "parent": { "type": ["string", "null"] },
          "layer_id": {
            "type": "string",
            "description": "Layer this bone controls"
          },
          "pivot": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            },
            "required": ["x", "y"]
          },
          "length": { "type": "number", "description": "Bone visual length in pixels" },
          "rotation": { "type": "number", "description": "Rest rotation in degrees" },
          "scale": {
            "type": "object",
            "properties": {
              "x": { "type": "number", "default": 1 },
              "y": { "type": "number", "default": 1 }
            }
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["rotation_limit", "ik", "stretch"] },
                "min": { "type": "number" },
                "max": { "type": "number" },
                "target": { "type": "string" }
              }
            }
          },
          "attachments": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Layer IDs attached to this bone"
          }
        }
      }
    }
  }
}
