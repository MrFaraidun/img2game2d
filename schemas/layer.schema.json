{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://img2game2d/schemas/layer.schema.json",
  "title": "Layer",
  "description": "A single decomposed visual layer of a 2D game asset",
  "type": "object",
  "required": ["id", "name", "type", "z_index"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique layer identifier (slug, e.g. 'left_arm')"
    },
    "name": {
      "type": "string",
      "description": "Human-readable layer name"
    },
    "type": {
      "type": "string",
      "enum": [
        "head", "face", "hair", "horn", "ear", "eye", "mouth", "nose",
        "neck", "torso", "chest", "back",
        "arm", "forearm", "hand", "shoulder",
        "leg", "lower_leg", "foot", "hip",
        "tail", "wing", "claw",
        "clothing", "armor", "cloak", "cape",
        "weapon", "shield", "accessory",
        "effect", "other"
      ],
      "description": "Semantic type of this layer"
    },
    "side": {
      "type": "string",
      "enum": ["left", "right", "center", "both"],
      "description": "Laterality of paired parts"
    },
    "parent": {
      "type": ["string", "null"],
      "description": "Parent layer ID (null = root)"
    },
    "z_index": {
      "type": "integer",
      "description": "Depth order (higher = front)"
    },
    "bounding_box": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      },
      "required": ["x", "y", "width", "height"]
    },
    "pivot": {
      "type": "object",
      "description": "Pivot point in [0,1] normalized coordinates relative to layer bounds",
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["x", "y"]
    },
    "attachment_point": {
      "type": "string",
      "description": "Semantic name of where this layer attaches (e.g. 'shoulder', 'hip')"
    },
    "rotation": {
      "type": "number",
      "description": "Initial rotation in degrees"
    },
    "scale": {
      "type": "object",
      "properties": {
        "x": { "type": "number", "default": 1 },
        "y": { "type": "number", "default": 1 }
      }
    },
    "visible": {
      "type": "boolean",
      "default": true
    },
    "occlusion": {
      "type": "object",
      "description": "Occlusion information for this layer",
      "properties": {
        "occluded_by": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Layer IDs that occlude (are in front of) this layer"
        },
        "occluded_region": {
          "type": "object",
          "description": "Approximate bounding box of the occluded area",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number" },
            "height": { "type": "number" }
          }
        },
        "reconstructed": {
          "type": "boolean",
          "description": "Whether the occluded region was reconstructed (inpainted)"
        }
      }
    },
    "source_file": {
      "type": "string",
      "description": "Path to the extracted layer PNG"
    }
  }
}
